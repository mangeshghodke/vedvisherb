    "@vitejs/plugin-react": "^6.0.3",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.1.2",
    "oxlint": "^1.71.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.2",
